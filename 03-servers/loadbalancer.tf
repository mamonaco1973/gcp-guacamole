# ==============================================================================
# FILE: loadbalancer.tf
# ------------------------------------------------------------------------------
# Global external Application Load Balancer in front of Guacamole: the only
# public piece of the lab.
#
#   https://<ip>/ (443) ─▶ backend service ─▶ instance group ─▶ Guacamole :8080
#   http://<ip>/  (80)  ─▶ redirect to https
#
# Notes:
#   - The certificate is self-signed (generated by Terraform for the load
#     balancer's IP), so browsers warn once. Its private key is in Terraform
#     state -- fine for a lab.
#   - Guacamole carries each desktop or SSH session over a WebSocket. On this
#     load balancer the backend service timeout is the longest a WebSocket
#     may stay open, so it is set to 24 hours instead of the 30 s default.
#   - A new load balancer takes a few minutes to start serving after
#     Terraform finishes; validate.sh waits for it.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public IP (global, static)
# ------------------------------------------------------------------------------
resource "google_compute_global_address" "guacamole" {
  name = "guacamole-lb-ip"
}

# ------------------------------------------------------------------------------
# Backend: an unmanaged instance group holding the Guacamole VM
# ------------------------------------------------------------------------------
resource "google_compute_instance_group" "guacamole" {
  name      = "guacamole-ig"
  zone      = var.zone
  instances = [google_compute_instance.guacamole.self_link]

  named_port {
    name = "http"
    port = 8080
  }
}

# Guacamole's web app answers 200 at / (WEBAPP_CONTEXT: ROOT) once it is up.
resource "google_compute_health_check" "guacamole" {
  name               = "guacamole-hc"
  check_interval_sec = 10
  timeout_sec        = 5

  http_health_check {
    port         = 8080
    request_path = "/"
  }
}

resource "google_compute_backend_service" "guacamole" {
  name                  = "guacamole-backend"
  protocol              = "HTTP"
  port_name             = "http"
  load_balancing_scheme = "EXTERNAL_MANAGED"
  timeout_sec           = 86400 # longest WebSocket (desktop session) lifetime
  health_checks         = [google_compute_health_check.guacamole.id]

  backend {
    group           = google_compute_instance_group.guacamole.self_link
    balancing_mode  = "UTILIZATION"
    capacity_scaler = 1.0
  }
}

# ------------------------------------------------------------------------------
# HTTPS front end (443) with a self-signed certificate
# ------------------------------------------------------------------------------
resource "tls_private_key" "guacamole" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_self_signed_cert" "guacamole" {
  private_key_pem       = tls_private_key.guacamole.private_key_pem
  validity_period_hours = 8760
  ip_addresses          = [google_compute_global_address.guacamole.address]

  subject {
    common_name  = google_compute_global_address.guacamole.address
    organization = "Guacamole lab"
  }

  allowed_uses = ["key_encipherment", "digital_signature", "server_auth"]
}

resource "google_compute_ssl_certificate" "guacamole" {
  name_prefix = "guacamole-cert-"
  private_key = tls_private_key.guacamole.private_key_pem
  certificate = tls_self_signed_cert.guacamole.cert_pem

  lifecycle {
    create_before_destroy = true
  }
}

resource "google_compute_url_map" "guacamole" {
  name            = "guacamole-url-map"
  default_service = google_compute_backend_service.guacamole.id
}

resource "google_compute_target_https_proxy" "guacamole" {
  name             = "guacamole-https-proxy"
  url_map          = google_compute_url_map.guacamole.id
  ssl_certificates = [google_compute_ssl_certificate.guacamole.id]
}

resource "google_compute_global_forwarding_rule" "https" {
  name                  = "guacamole-https"
  target                = google_compute_target_https_proxy.guacamole.id
  ip_address            = google_compute_global_address.guacamole.id
  port_range            = "443"
  load_balancing_scheme = "EXTERNAL_MANAGED"
}

# ------------------------------------------------------------------------------
# HTTP front end (80): redirect everything to HTTPS
# ------------------------------------------------------------------------------
resource "google_compute_url_map" "http_redirect" {
  name = "guacamole-http-redirect"

  default_url_redirect {
    https_redirect         = true
    redirect_response_code = "MOVED_PERMANENTLY_DEFAULT"
    strip_query            = false
  }
}

resource "google_compute_target_http_proxy" "http_redirect" {
  name    = "guacamole-http-proxy"
  url_map = google_compute_url_map.http_redirect.id
}

resource "google_compute_global_forwarding_rule" "http" {
  name                  = "guacamole-http"
  target                = google_compute_target_http_proxy.http_redirect.id
  ip_address            = google_compute_global_address.guacamole.id
  port_range            = "80"
  load_balancing_scheme = "EXTERNAL_MANAGED"
}
